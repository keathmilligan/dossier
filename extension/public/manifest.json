{
  "manifest_version": 3,
  "name": "Dossier",
  "version": "0.1.0",
  "description": "Topic-scoped research capture. Local-first.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging",
    "contextMenus",
    "sidePanel",
    "scripting",
    "webNavigation"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["http://127.0.0.1:18765/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Dossier",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": { "default_path": "src/ui/panel.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
